/* ================================
   CPM (Correlativos Perfiles y Moldes)
================================ */

.admin-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(148, 163, 184, .18);
    padding-bottom: 2px;
}

.admin-tab {
    border: 0;
    background: transparent;
    color: #94a3b8;
    font-weight: 800;
    padding: 12px 18px;
    border-radius: 12px 12px 0 0;
    cursor: pointer;
}

.admin-tab.is-active {
    background: rgba(37, 99, 235, .16);
    color: #fff;
    box-shadow: inset 0 -3px 0 #2563eb;
}

.admin-tab-panel {
    display: none;
}

.admin-tab-panel.is-active {
    display: block;
}

.admin-alert {
    border-radius: 14px;
    padding: 12px 16px;
    margin-bottom: 18px;
    font-weight: 700;
}

.admin-alert.hidden {
    display: none;
}

.admin-alert-success {
    background: rgba(34, 197, 94, .14);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, .28);
}

.admin-alert-error {
    background: rgba(220, 38, 38, .14);
    color: #fca5a5;
    border: 1px solid rgba(220, 38, 38, .28);
}

.admin-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
    align-items: end;
}

.admin-form-field-full {
    grid-column: 1 / -1;
}

.admin-form-field label {
    display: block;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 6px;
}

.admin-form-field input,
.admin-form-field select,
.admin-form-field textarea {
    width: 100%;
    min-height: 42px;
    border-radius: 12px;
    border: 1px solid rgba(148, 163, 184, .25);
    background: rgba(255,255,255,.08);
    color: #fff;
    padding: 10px 12px;
    outline: none;
    font-family: inherit;
}

.admin-form-field textarea {
    min-height: 64px;
    resize: vertical;
}

.admin-form-field option {
    color: #111827;
}

.admin-form-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
}

.admin-filters-cpm {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
}

.admin-section-toggle {
    border: 1px solid rgba(148, 163, 184, .25);
    border-radius: 12px;
    margin-bottom: 14px;
    overflow: hidden;
}

.admin-section-toggle > summary {
    list-style: none;
    cursor: pointer;
    padding: 12px 16px;
    font-weight: 800;
    color: #fff;
    background: rgba(255, 255, 255, .04);
    display: flex;
    align-items: center;
    gap: 8px;
}

.admin-section-toggle > summary::-webkit-details-marker {
    display: none;
}

.admin-section-toggle > summary::before {
    content: "\25B8";
    transition: transform .15s ease;
}

.admin-section-toggle[open] > summary::before {
    transform: rotate(90deg);
}

.admin-section-toggle-body {
    padding: 16px;
}

.admin-filter-checkbox {
    display: flex;
    align-items: flex-end;
}

.admin-filter-checkbox label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 800;
    min-height: 42px;
}

.admin-filter-checkbox input {
    width: 16px;
    height: 16px;
}

