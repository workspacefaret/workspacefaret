}

.admin-modal-column h3 {
    margin: 0 0 12px;
    font-size: 15px;
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.admin-modal-column-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.admin-modal-proceso {
    border: 1px solid rgba(148, 163, 184, .16);
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
}

.admin-modal-proceso:last-child {
