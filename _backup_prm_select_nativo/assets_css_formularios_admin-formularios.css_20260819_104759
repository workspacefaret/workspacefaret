}

.admin-modal-mini-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    color: #e5e7eb;
}

.admin-modal-mini-table th,
.admin-modal-mini-table td {
    padding: 8px 6px;
    border-bottom: 1px solid rgba(148, 163, 184, .14);
